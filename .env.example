# PostgreSQL connection string (required); matches `make db-up`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/link_shortener?sslmode=disable
# Host port of the compose PostgreSQL (default 5432); if it is taken,
# set another one here and in DATABASE_URL.
# POSTGRES_PORT=5433
# Public origin for short_url, no path (default http://localhost:8080)
BASE_URL=http://localhost:8080
# Per-request budget, Go duration (default 10s)
REQUEST_TIMEOUT=10s
# Sentry DSN; empty disables reporting
SENTRY_DSN=
